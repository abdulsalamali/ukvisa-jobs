# Local SQLite file. For production use a Turso URL: libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:data/jobs.db
TURSO_AUTH_TOKEN=

# Optional. Each source is skipped when its keys are missing.
# Free tier: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Free key: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
